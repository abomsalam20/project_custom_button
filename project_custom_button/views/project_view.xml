<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_sms_button" model="ir.ui.view">
        <field name="name">project.task.form.sms.button</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <button name="open_url" 
                        string="open Github" 
                        type="object" 
                        class="oe_highlight"
                        icon="fa-paper-plane-o"/>

            </xpath>

        </field>
    </record>


</odoo>